{
  "name": "review-bot",
  "version": "0.1.0",
  "private": true,
  "description": "이대리 코드 리뷰 워커를 떼어 낸 개인용 PR 리뷰 봇 — 로컬 대시보드, 레포 규칙 반영, 기각 학습",
  "type": "module",
  "bin": {
    "pr-review": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js",
    "check": "tsx src/doctor-cli.ts",
    "cli": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=22.4"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@inquirer/prompts": "^8.8.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
